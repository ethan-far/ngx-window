{
    "name": "ngx-window-demo",
    "version": "0.5.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve -o --host 127.0.0.1 --port 4100",
        "build": "ng build",
        "sync:readme": "node scripts/sync-readme.js",
        "build:lib": "ng build ngx-window",
        "prebuild:lib": "npm run sync:readme",
        "watch": "ng build --watch --configuration development",
        "test": "jest --watch",
        "test:jest": "jest",
        "test:coverage": "jest --coverage",
        "release": "npm run build:lib && npm publish ./dist/ngx-window"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.0.0",
        "@angular/cdk": "^21.0.0",
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.0.0",
        "@angular/platform-browser": "^21.0.0",
        "@angular/platform-browser-dynamic": "^21.0.0",
        "@angular/router": "^21.0.0",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "^0.15.0"
    },
    "devDependencies": {
        "@angular-builders/jest": "^21.0.3",
        "@angular-devkit/build-angular": "^21.2.2",
        "@angular-eslint/builder": "^21.0.0",
        "@angular-eslint/eslint-plugin": "^21.0.0",
        "@angular-eslint/eslint-plugin-template": "^21.0.0",
        "@angular-eslint/schematics": "^21.0.0",
        "@angular-eslint/template-parser": "^21.0.0",
        "@angular/cli": "^21.0.0",
        "@angular/compiler-cli": "^21.0.0",
        "@angular/language-service": "^21.0.0",
        "@types/jest": "^29.5.13",
        "@types/node": "^22.5.5",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.3.0",
        "jest-extended": "^4.0.2",
        "jest-jasmine2": "^29.7.0",
        "jest-preset-angular": "^16.1.1",
        "ng-mocks": "^14.15.2",
        "ng-packagr": "^21.0.0",
        "ts-jest": "^29.4.6",
        "ts-mockito": "^2.6.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "undici": "^7.24.4"
    }
}
